# 复制为 .env 后填入真实密钥（密钥见项目根 api_key.txt，切勿提交）

# ===== API Keys =====
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
TAVILY_API_KEY=
# 可选备选搜索：BOCHA_API_KEY=（SEARCH_PROVIDER 改为 bocha 时使用）
# MOONSHOT_API_KEY=

# ===== 模型按任务路由 =====
INTERVIEW_LLM_PROVIDER=dashscope
INTERVIEW_LLM_MODEL=qwen-plus
JUDGE_LLM_PROVIDER=deepseek
JUDGE_LLM_MODEL=deepseek-chat
OCR_LLM_PROVIDER=dashscope
OCR_LLM_MODEL=qwen3-vl-plus
DRAFT_LLM_PROVIDER=dashscope
DRAFT_LLM_MODEL=qwen-max
REVIEW_LLM_PROVIDER=zhipu
REVIEW_LLM_MODEL=glm-4-plus
MEM0_LLM_PROVIDER=dashscope
MEM0_LLM_MODEL=qwen-flash

EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1024

# ===== 联网搜索 =====
SEARCH_PROVIDER=tavily

# ===== 服务 =====
HOST=127.0.0.1
PORT=8010
